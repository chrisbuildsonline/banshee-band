{
  "name": "banshee-band",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "e2e": "playwright test",
    "docker:serve": "docker build -t banshee-band . && docker run --rm -p 4173:4173 banshee-band",
    "docker:test": "docker build --target test -t banshee-band-test . && docker run --rm --ipc=host banshee-band-test",
    "typecheck": "tsc --noEmit",
    "icons": "bun run scripts/make-icons.ts",
    "classify:report": "bun run tests/classify/report.ts",
    "bearing:report": "bun run tests/bearing/report.ts",
    "bearing:mutate": "bun run tests/bearing/mutate.ts",
    "haptics:mutate": "bun run tests/haptics/mutate.ts",
    "mcp:banshee-log": "bun mcp/banshee-log.ts",
    "log:seed": "bun scripts/log-clips.ts",
    "hooks:patterns": "bun scripts/hooks/patterns.ts",
    "hooks:spec-tests": "bun scripts/hooks/spec-tests.ts",
    "hooks:colour": "bun scripts/hooks/colour-alerts.ts",
    "hooks:fixtures": "bun scripts/hooks/fixtures.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "fast-check": "^4.10.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@tensorflow/tfjs": "4.22.0",
    "zod": "^4.6.7"
  }
}
